						trip = <0x416>;
						cooling-device = <0x4c 0x03 0x03>;
					};
				};
			};

			xo-therm-step {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x417 0x644>;

				trips {

					modem-pa-fr1-trip0 {
