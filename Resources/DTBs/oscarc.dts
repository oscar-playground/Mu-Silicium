					disp_pins {

						disp_pins_reset {
							phandle = <0x408>;
						};
					};

					key_vol_down {

						key_vol_down {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x422>;
						};
					};

					pmr735a_chg_pins {
						phandle = <0x46b>;

						dischg_enable {
							pins = "gpio3";
