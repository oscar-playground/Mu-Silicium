					#thermal-sensor-cells = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					io-channels = <0x3f9 0x52 0x3f9 0x53>;
					phandle = <0x3fe>;

					msm_therm {
						reg = <0x52>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					rfc_cam_therm {
						reg = <0x53>;
