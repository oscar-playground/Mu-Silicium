/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Blair QRD NOPMI";
	compatible = "qcom,blair-qrd", "qcom,blair", "qcom,qrd";
	qcom,msm-id = <0x1fb 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x1000b 0x00>;

	chosen {
		linux,initrd-end = <0x00 0xafffe7fe>;
		linux,initrd-start = <0x00 0xae91b000>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "log_buf_len=256K rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off androidboot.hardware=qcom androidboot.memcg=1 lpm_levels.sleep_disabled=1 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=4e00000.dwc3 swiotlb=0 loop.max_part=7 cgroup.memory=nokmem,nosocket iptable_raw.raw_before_defrag=1 ip6table_raw.raw_before_defrag=1 kpti=off  lk_version=V1.0 androidboot.startupmode=hard_reset androidboot.mode=normal printk.disable_uart=1 short_c_feature_sw_status=0 phx_rus_conf.main_on=1 phx_rus_conf.recovery_method=2 phx_rus_conf.kernel_time=240 phx_rus_conf.android_time=250 smooth_soc_switch=0 simcardnum.doublesim=1 androidboot.prjname=21708 esim.status=0 androidboot.hw_region_id=0 oplusboot.rpmb_enabled=1 oplus.avbkeysha256=2544763afe29a6da3a4a7a41ab88b1fd28a29e38bbd2debea4602b20cd838545 androidboot.verifiedbootstate=orange androidboot.keymaster=1  androidboot.bootdevice=4804000.ufshc androidboot.fstab_suffix=default androidboot.boot_devices=soc/4804000.ufshc androidboot.serialno=992038e0 androidboot.baseband=msm msm_drm.dsi_display0=qcom,mdss_dsi_oplus21707_dsbj_ili7807s_fhd_plus_144fps_video: oplus_bsp_tp_custom.dsi_display0=qcom,mdss_dsi_oplus21707_dsbj_ili7807s_fhd_plus_144fps_video:tp_nt36672c_tm androidboot.slot_suffix=_b rootwait ro init=/init androidboot.dtbo_idx=14 androidboot.dtb_idx=0 androidboot.force_normal_boot=1";
	};

	memory {
		ddr_device_hbb_ch1_rank1 = <0x0e>;
		ddr_device_hbb_ch1_rank0 = <0x0e>;
		ddr_device_rank_ch1 = <0x02>;
		ddr_device_hbb_ch0_rank1 = <0x0e>;
		ddr_device_hbb_ch0_rank0 = <0x0e>;
		ddr_device_rank_ch0 = <0x02>;
		ddr_device_type = <0x07>;
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x3cc00000 0x01 0x00 0x01 0x00 0x00 0xc0000000 0x00 0x40000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x1df>;

		hyp@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x1e0>;
		};

		xbl_aop_mem@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x100000>;
			phandle = <0x1e1>;
		};

		reserved_xbl_uefi@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x14000>;
			phandle = <0x1e2>;
		};

		smem@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0x7a>;
		};

		fw_mem@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x1e3>;
		};

		cdsp_secure_heap_mem@80c00000 {
			no-map;
			reg = <0x00 0x80c00000 0x00 0xa00000>;
			phandle = <0xaa>;
		};

		wlan@86500000 {
			no-map;
			reg = <0x00 0x86500000 0x00 0x200000>;
			phandle = <0x1d2>;
		};

		adsp@86700000 {
			no-map;
			reg = <0x00 0x86700000 0x00 0x2800000>;
			phandle = <0x8d>;
		};

		cdsp@88700000 {
			no-map;
			reg = <0x00 0x9b800000 0x00 0x1e00000>;
			phandle = <0x90>;
		};

		video@8a500000 {
			no-map;
			reg = <0x00 0x8a500000 0x00 0x500000>;
			phandle = <0x84>;
		};

		ipa_fw@8aa00000 {
			no-map;
			reg = <0x00 0x8aa00000 0x00 0x10000>;
			phandle = <0x97>;
		};

		ipa_gsi@8aa10000 {
			no-map;
			reg = <0x00 0x8aa10000 0x00 0xa000>;
			phandle = <0x1e4>;
		};

		gpu_micro_code@8aa1a000 {
			no-map;
			reg = <0x00 0x8aa1a000 0x00 0x2000>;
			phandle = <0x9f>;
		};

		mpss_wlan@8b800000 {
			no-map;
			reg = <0x00 0x8b800000 0x00 0x10000000>;
			phandle = <0x93>;
		};

		removed_region@c0000000 {
			no-map;
			reg = <0x00 0xc0000000 0x00 0x8800000>;
			phandle = <0x1e5>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0xab>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
			phandle = <0x55>;
		};

		splash_region@0x85200000 {
			reg = <0x00 0x85200000 0x00 0xc00000>;
			label = "cont_splash_region";
			phandle = <0x1e6>;
		};

		dfps_data_region@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x100000>;
			label = "dfps_data_region";
			phandle = <0x170>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x86>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0xac>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0x96>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0xad>;
		};

		memshare_region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			alignment = <0x00 0x100000>;
			size = <0x00 0x800000>;
			phandle = <0x61>;
		};

		kboot_uboot_logmem@0x9FE00000 {
			reg = <0x00 0x9fe00000 0x00 0x200000>;
			compatible = "oplus,xbl_uefi_kbootlog";
			xbluefi-offset = <0x1f7000>;
			no-map;
			phandle = <0x4aa>;
		};

		ramoops@0xE9700000 {
			compatible = "ramoops";
			reg = <0x00 0xe9700000 0x00 0x600000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x100000>;
			pmsg-size = <0x100000>;
			devinfo-size = <0x8000>;
			ecc-size = <0x00>;
			phandle = <0x4ab>;
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x400>;
	};

	aliases {
		ufshc1 = "/soc/ufshc@4804000";
		sdhc0 = "/soc/sdhci@4744000";
		sdhc1 = "/soc/sdhci@4784000";
		serial0 = "/soc/qcom,qup_uart@4c8c000";
		hsuart0 = "/soc/qcom,qup_uart@4a84000";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/va-macro@A730000/va_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@A600000/rx_swr_master";
		i2c2 = "/soc/i2c@4c90000";
	};

	firmware {
		phandle = <0x1e7>;

		scm {
			compatible = "qcom,scm";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,vendor_boot";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/4744000.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "disabled";
				};
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x04>;

				l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x07>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x11>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x08>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x12>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x08>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x13>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0a>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x14>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0a>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0b>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x15>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			cpu-idle-states = <0x0c 0x0d>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0e>;
			qcom,freq-domain = <0x05 0x01 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0e>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			cpu-idle-states = <0x0c 0x0d>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0f>;
			qcom,freq-domain = <0x05 0x01 0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				core2 {
					cpu = <0x12>;
				};

				core3 {
					cpu = <0x13>;
				};

				core4 {
					cpu = <0x14>;
				};

				core5 {
					cpu = <0x15>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x16>;
				};

				core1 {
					cpu = <0x17>;
				};
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		#gpio-cells = <0x02>;
		compatible = "simple-bus";
		phandle = <0x1e8>;

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};

		slim@a5c0000 {
			cell-index = <0x01>;
			compatible = "qcom,slim-ngd";
			reg = <0xa5c0000 0x2c000 0xa584000 0x20000 0xa66e000 0x2000>;
			reg-names = "slimbus_physical", "slimbus_bam_physical", "slimbus_lpass_mem";
			interrupts = <0x00 0x11b 0x04 0x00 0x11c 0x04>;
			interrupt-names = "slimbus_irq", "slimbus_bam_irq";
			qcom,apps-ch-pipes = <0x00>;
			qcom,ea-pc = <0x3b0>;
			status = "ok";
			phandle = <0x1e9>;

			wcn3990 {
				compatible = "qcom,btfmslim_slave";
				elemental-addr = [00 01 20 02 17 02];
				qcom,btfm-slim-ifd = "btfmslim_slave_ifd";
				qcom,btfm-slim-ifd-elemental-addr = [00 00 20 02 17 02];
				phandle = <0x1ea>;
			};
		};

		interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			#redistributor-regions = <0x01>;
			redistributor-stride = <0x00 0x20000>;
			reg = <0xf200000 0x10000 0xf240000 0x100000>;
			interrupts = <0x01 0x08 0x04>;
			#gpio-cells = <0x00>;
			phandle = <0x01>;
		};

		qcom,spmi@1c40000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0x1c40000 0x1100 0x1e00000 0x2000000 0x3e00000 0x100000 0x3f00000 0xa0000 0x1c0a000 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts-extended = <0x18 0x56 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;
			cell-index = <0x00>;
			phandle = <0x1eb>;

			qcom,pm6125@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr", "resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;
					qcom,pmicwd;
					qcom,log-kpd-event;
					phandle = <0x462>;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,pull-up;
						linux,code = <0x74>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						qcom,pull-up;
						linux,code = <0x72>;
					};
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <0x3f5 0x3f6 0x3f7 0x3f8>;
					phandle = <0x3f9>;

					ref_gnd {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1 {
						reg = <0x4d>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					quiet_therm {
						reg = <0x4e>;
						label = "quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm2 {
						reg = <0x55>;
						label = "pa_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					msm_therm {
						reg = <0x52>;
						label = "msm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
