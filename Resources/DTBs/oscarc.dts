							bias-disable;
							power-source = <0x00>;
							output-high;
							qcom,drive-strength = <0x03>;
							phandle = <0x457>;
						};

						dischg_disable {
							pins = "gpio3";
							function = "normal";
							bias-disable;
							power-source = <0x00>;
							output-low;
							qcom,drive-strength = <0x03>;
							phandle = <0x458>;
						};
					};
				};

				vadc@3600 {
					compatible = "qcom,spmi-adc7-sw-calib";
					reg = <0x3600 0x3900>;
					reg-names = "adc5-sw-calib-pbs-base", "adc5-sw-calib-cmn-base";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x04 0x36 0x00 0x01>;
					interrupt-names = "eoc";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					status = "ok";
					pinctrl-names = "default";
					pinctrl-0 = <0x3fc>;
					phandle = <0x3fd>;

					pmr735a_ref_gnd {
						reg = <0x00>;
						label = "pmr735a_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
